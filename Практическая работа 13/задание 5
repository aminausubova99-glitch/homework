num = list(map(int, input().split())) #вывод числа и делаем строку в список целых 

count = 0 #для подсчёта одинаковых пар

for i in range(len(num)): #разбираем все элементы списка
    for j in range(i + 1, len(num)): #сравниваем элемент со следующими элементами
        if num[i] == num[j]:
            count += 1

print(count)
