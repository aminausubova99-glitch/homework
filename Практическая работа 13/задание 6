numbers = [8, 9, 10, 11] #это список целых чисел

numbers[1] = 17 #замена второй элемент списка на 17
numbers.extend([4, 5, 6]) #добавляем их в конце списка 
numbers.pop(0) #теперь удаляем первый элемент списка
numbers.extend(numbers.copy()) #надо удвоить список, добавить его копию в конец
numbers.insert(3, 25) #крч, ставим число 25 по индексу 3

print(numbers)
