the_biggest = 0  #переменная для хранения самого большого числа

while True:
    #ввод очередного числа
    number = int(input("Введите натуральное число (0 - остановка): "))

    if number == 0:
        break  #завершаем цикл при вводе нуля

    elif number > the_biggest:
        the_biggest = number  #запоминаем большое число

#выводим найденное самое большое число
print("Самое большое число:", the_biggest)
