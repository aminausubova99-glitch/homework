one = int(input("Введите первое число: "))

while True:
    two = int(input("Введите второе число: "))

    if two > one:
        break #если число подходит можно переходить дальшке
    else:
        print("Ошибка. Введите второе число заново, т.к второе число должно быть больше первого")

while True:
    three = int(input("Введите третье число: "))

    if three > two:
        break #если число подходит, заканчиваем проверку
    else:
        print("Ошибка. Введите третье число заново, т.к третье число должно быть больше второго")

print("Последовательность принята") #выводим сообщение после успешной проверки
