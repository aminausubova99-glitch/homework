#вводим ип адреса 3 серверов
server1 = set(input().split())
server2 = set(input().split())
server3 = set(input().split())

all_ips = server1 | server2 | server3 #соединение все ип адреса

common = server1 & server2 & server3 #ищем ип, которые есть во всех трех логах

result = all_ips - common #теперь убираем адреса, которые встречаются во трех

print(*sorted(result)) #выводим результат по возрастанию
