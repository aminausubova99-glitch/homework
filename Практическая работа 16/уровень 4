#имена агентов 3 организаций
cru = set(input("Введите имена ЦРУ: ").split())
mi6 = set(input("Введите имена МИ-6: ").split())
kgb = set(input("Введите имена КГБ: ").split())

agents = cru & mi6 #ищем агентов у которых есть цру и ми6

result = agents - kgb #теперь надо убрать агентов у которых есть в кгб

print("Двойные агенты:", " ".join(sorted(result, reverse=True))) #полученный результат выводим по убыванию
