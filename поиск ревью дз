s = input()

while len(s) <= 10:  #надо использовать <
    if len(s) // 4:  #тут надо проверять len(s) % 4 == 0
        s = s + 'x'
    elif len(s) // 5 == 0:  #тут тоже надо проверять len(s) % 5 == 0
        s = s + 'y'
    else:
        s = s + 'z'  #где написано z надо его добавлять слева

s = '&' + s  #а тут надо добавить символ @
print(s)

