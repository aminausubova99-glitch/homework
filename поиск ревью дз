#задание 5 
n = int(input())
max_digit = n % 10  #надо задать начальное значение -1
while n > 0:
    digit = n % 10
    if digit % 3 == 0:
        if digit < max_digit:  #надо сравнивать с помощью >
            digit = max_digit  #надо написать max_digit = digit
    n = n % 10  #надо удалить последнюю цифру с помощью //
if max_digit == 0:  #надо проверить max_digit == -1
    print('NO')
else:
    print(max_digit)

