#задание 2 проверка возможности скрещивания

hybrids_info = input("Введите список возможных гибридов: ")  #получаем список гибридов
plants_info = input("Введите два растения через пробел: ")  #получаем два названия

hybrids = hybrids_info.split(";")  #разделяем список гибридов
plant_num = plants_info.split()  #разделяем названия растений

if len(plant_num) == 2:  #проверяем, что введены два растения
    first_plant = plant_num[0]  #сохраняем первое растение
    second_plant = plant_num[1]  #сохраняем второе растение
    hybrid_found = False  #пока подходящий гибрид не найден

    for hybrid in hybrids:  #проверяем каждый гибрид
        parents, hybrid_name = hybrid.split("=")  #отделяем главных от названия гибрида
        parent_num = parents.split("+")  #получаем названия растений для главных 

        if (first_plant in parent_num  #проверяем первое растение
            and second_plant in parent_num  #проверяем второе растение
            and len(parent_num) == 2): #убеждаемся, что родителей ровно два

            print(f"Получен гибрид: {hybrid_name}") 
            hybrid_found = True  #запоминаем, что гибрид найден
            break 

    if not hybrid_found:  #если гибрид не найден
        print("Эти растения нельзя скрестить") 
else:
    print("Ошибка: необходимо ввести два названия растений")  #сообщаем об ошибке ввода


#задание 3 определение характеристик гибрида

first_name = input("Введите название первого растения: ")  #получаем первое название
first_color, first_size, first_growth = input("Введите цвет, размер и рост первого растения: ").split()  #сохраняем характеристики 1 растения

sec_name = input("Введите название второго растения: ")  #получаем второе название
sec_color, sec_size, sec_growth = input("Введите цвет, размер и рост второго растения: "
).split()  #сохраняем характеристики 2 растения


#задание 3.1 определение цвета

if first_name <= second_name:  #сравниваем названия по алфавиту
    hybrid_color = first_color  #берём цвет 1 растения
else:
    hybrid_color = second_color  #берём цвет 2 растения


#задание 3.2 определение размера

size_order = ["малый", "средний", "крупный"]  #задаём по очереди размер

if first_size == sec_size:  #проверяем, одинаковые ли размеры
    hybrid_size = first_size  #ну если одинаковые, сохраняем размер
else:
    sizes = sorted([first_size, sec_size],  #собираем оба размера в список
        key=lambda size: size_order.index(size)) #сортируем как просят
    hybrid_size = "/".join(sizes)  #объединяем размеры через /


#задание 3.3 определение скорости роста

growth_order = ["медленный", "средний", "быстрый"]  #задаём порядок скоростей роста

hybrid_growth = min([first_growth, second_growth],  #сравниваем скорости роста
    key=lambda growth: growth_order.index(growth))  #выбираем медленный 



print("Характеристики гибрида:")
print(f"Цвет: {hybrid_color}")  #вывод цвет гибрида
print(f"Размер: {hybrid_size}")  #вывод размер гибрида
print(f"Рост: {hybrid_growth}")  #вывод скорость роста гибрида
