number = int(input("Введите номер кармана: "))

#проверяем, входит ли номер в диапазон от 0 до 36
if number < 0 or number > 36:
    print("ошибка ввода")

#карман 0 всегда зеленый
elif number == 0:
    print("зеленый")

#определяем цвет карманов от 1 до 10
elif 1 <= number <= 10:
    if number % 2 == 0:
        print("черный")
    else:
        print("красный")

#определяем цвет карманов от 11 до 18
elif 11 <= number <= 18:
    if number % 2 == 0:
        print("красный")
    else:
        print("черный")

#определяем цвет карманов от 19 до 28
elif 19 <= number <= 28:
    if number % 2 == 0:
        print("черный")
    else:
        print("красный")

#определяем цвет карманов от 29 до 36
else:
    if number % 2 == 0:
        print("красный")
    else:
        print("черный")
