import random
print("📦 Отслеживание товара 📦")

#вводим статус заказа
status = input(
    "Введите статус заказа "
    "(pending, processing, shipped, delivered, cancelled): "
).strip().lower()

#проверяем, какой статус ввёл пользователь
match status:
    case "pending":
        status_ru = "В ожидании"
        description = "Заказ принят и ожидает начала обработки"
        emoji = "⏳"
        time = f"{random.randint(1, 2)} дня"

    case "processing":
        status_ru = "В обработке"
        description = "Заказ собирается и подготавливается к отправке"
        emoji = "⚙️"
        time = f"{random.randint(1, 3)} дня"

    case "shipped":
        status_ru = "Отправлен"
        description = "Заказ передан в службу доставки"
        emoji = "🚚"
        time = f"{random.randint(2, 5)} дня"

    case "delivered":
        status_ru = "Доставлен"
        description = "Заказ успешно доставлен получателю"
        emoji = "✅"
        time = "Доставка завершена"
    case "cancelled":
        status_ru = "Отменён"
        description = "Заказ был отменён"
        emoji = "❌"
        time = "Обработка прекращена"

    case _:
        #если введённого статуса нет в списке
        status_ru = "Неизвестный статус"
        description = "Такого статуса нет в системе"
        emoji = "⚠️"
        time = "Недоступно"

#выводим всю информацию о заказе
print("\n" + "=" * 45)
print(f"📦 Статус: {status_ru}")
print(f"{emoji} Состояние: {description}")
print(f"⏰ Время обработки: {time}")
print("=" * 45)
