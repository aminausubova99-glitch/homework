import math

def calculate_distance(x1, y1, x2, y2):
    """Вычисляет расстояние между двумя точками"""
    return math.sqrt((x2 - x1) ** 2 + (y2 - y1) ** 2)  #находим расстояние между точками

def calculate_triangle_area(a, b, c):
    """Вычисляет площадь треугольника по формуле Герона"""
    semi_perimeter = (a + b + c) / 2  #находим полупериметр треугольника

    return math.sqrt(
        semi_perimeter
        * (semi_perimeter - a)
        * (semi_perimeter - b)
        * (semi_perimeter - c)
    )  #находим площадь по формуле Герона

x1, y1, x2, y2, x3, y3 = map(float,input('Введите координаты трёх точек: ').split()) #вводим координаты

side_a = calculate_distance(x1, y1, x2, y2)  #находим длину первой стороны
side_b = calculate_distance(x2, y2, x3, y3)  #находим длину второй стороны
side_c = calculate_distance(x3, y3, x1, y1)  #находим длину третей стороны

area = calculate_triangle_area(side_a, side_b, side_c)  #вычисляем площадь треугольника

print(f'Площадь треугольника: {area:.2f}')  #выводим результат 
