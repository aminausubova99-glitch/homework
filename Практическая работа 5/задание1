TAX_RATE = 0.13 #ставка налога 13%

income = float(input('Введите годовой доход: ')) #вводим доход

tax = income * TAX_RATE  #считаем налог
money_after_tax = income - tax  #считаем доход после налога

print(f'Общая сумма дохода: {income:,.2f} руб.'.replace(',', ' '))
print(f'Сумма налога: {tax:,.2f} руб.'.replace(',', ' '))
print(f'Сумма на руки: {money_after_tax:,.2f} руб.'.replace(',', ' '))
