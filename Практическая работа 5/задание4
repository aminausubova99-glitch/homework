import math

def calculate_rectangle_area(width, height):
    """Вычисляет площадь прямоугольника"""
    return width * height #считаем площадь прямоугольника

def calculate_circle_area(radius):
    """Вычисляет площадь круга"""
    return math.pi * radius ** 2 #считаем площадь круга

width, height = map( float,input('Введите ширину и высоту прямоугольника: ').strip()) #задаем ширину и высоту
rectangle_area = calculate_rectangle_area(width, height) #вызываем функцию
print(f'Площадь прямоугольника: {rectangle_area:.2f}')  #выводим результат

radius = float(input('Введите радиус круга: ')) #вводим радиус
circle_area = calculate_circle_area(radius) #вызываем функцию
print(f'Площадь круга: {circle_area:.2f}') #выводим результат 
