import random

answers = ["Бесспорно",
    "Предрешено",
    "Никаких сомнений",
    "Определённо да",
    "Можешь быть уверен в этом",
    "Мне кажется, да",
    "Вероятнее всего",
    "Хорошие перспективы",
    "Знаки говорят — да",
    "Да",
    "Пока неясно, попробуй снова",
    "Спроси позже",
    "Лучше не рассказывать",
    "Сейчас нельзя предсказать",
    "Сконцентрируйся и спроси опять",
    "Даже не думай",
    "Мой ответ — нет",
    "По моим данным — нет",
    "Перспективы не очень хорошие",
    "Весьма сомнительно"]

print("Привет Мир, я магический шар, и я знаю ответ на любой твой вопрос")

name = input("Как тебя зовут? ")

print("Привет", name)

#запускаем бесконечный цикл
while True:
    question = input("Задай свой вопрос: ")

    #проверка, ввёл ли пользователь вопрос
    if question == "":
        print("Ты не задал вопрос!")
        continue
    else:
        print(random.choice(answers))

    #теперь спрашиваем хочет ли пользователь продолжить
    again = input("Хочешь задать ещё вопрос? (да/нет): ")

    #проверка ответа
    if again.lower() == "да":
        continue
    elif again.lower() == "нет":
        print("Возвращайся, если возникнут вопросы!")
        break
    else:
        print("Я не понял ответ. Программа завершится")
        break
