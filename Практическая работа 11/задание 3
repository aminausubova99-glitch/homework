for a in range(1, 151):  
    for b in range(a, 151):  
        for c in range(b, 151): 
            for d in range(c, 151): 
                total = a**5 + b**5 + c**5 + d**5
                e = int(total ** 0.2)  #находим мб пятое коренное число

                if e**5 == total:  #проверяем, подходит ли число e
                    print(a, b, c, d, e)  #выводим числа
                    print(a + b + c + d + e)  #выводим сумму чисел
