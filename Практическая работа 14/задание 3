num = [[5, -2, 0, 8], [-1, 3, -7, 4], [0, -6, 2, 9]]

filtered_numbers = [] #пустой список для положительных чисел

i = 0
while i < len(num):
    filtered_row = [] #создадим пустую строку
    j = 0

    while j < len(num[i]): #проверка на каждое число в строке
        if num[i][j] > 0:  #ну если число больше нуля, мы добавляем его
            filtered_row.append(num[i][j])
        j += 1

    filtered_numbers.append(filtered_row) #теперь добавляем строку в новый список
    i += 1

print("Исходный список:", num)
print("Новый список:", filtered_numbers)
