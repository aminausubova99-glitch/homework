        if prices_descending[j] < prices_descending[j + 1]:  #проверяем порядка цен
            prices_descending[j], prices_descending[j + 1] = prices_descending[j + 1], prices_descending[j]  #обмены элементов
        j += 1  #переходим к следующему 
    i += 1 

