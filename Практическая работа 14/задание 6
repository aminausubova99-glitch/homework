i = 0  #счётчик проходов
while i < len(prices_increases) - 1:  #также повторение проходов по списку
    j = 0 
    while j < len(prices_increases) - 1 - i:  #сравнение соседних элементов
        if prices_increases[j] > prices_increases[j + 1]:  #проверяем порядок цен
            prices_increases[j], prices_increases[j + 1] = prices_increases[j + 1], prices_increases[j] #обмены элементов
        j += 1  #переходим к следующему элементу
