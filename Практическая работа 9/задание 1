n = int(input("Введите число n"))

number = 1  #начинаем проверку с числа 1

while number <= n: #цикл работает, пока number не станет больше n

    #пропускаем числа из этих диапазонов
    if 5 <= number <= 9 or 17 <= number <= 37 or 78 <= number <= 87:
        number += 1
        continue

    #выводим число 
    print(number)

    #переходим к следующему числу 
    number += 1
