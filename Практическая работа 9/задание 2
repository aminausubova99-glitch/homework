count = 0  #счетчик людей 
counting = False  #пока Александра не найдем, людей не считаем

while True:
    name = input()  #вводим имя следующего участника

    if name == "Левон":
        break  #если нашли Левона, заканчиваем цикл 

    if counting:
        count += 1  #если Александра уже была, считаем человека 

    if name == "Александра":
        counting = True  #после Александры начинаем считать людей

print(f"{count}")  #выводим количество людей между ними 
