amount = int(input())

coin_count = 0 #счётчик монет начинаем с 0

#выдаём монеты по 25, пока остаток не станет меньше 25
while amount >= 25:
    coin_count += 1
    amount -= 25

#выдаём монеты по 10, пока остаток не станет меньше 10
while amount >= 10:
    coin_count += 1
    amount -= 10

#выдаём монеты по 5, пока остаток не станет меньше 5
while amount >= 5:
    coin_count += 1
    amount -= 5

#выдаём монеты по 1, пока остаток не станет равен 0
while amount >= 1:
    coin_count += 1
    amount -= 1

#выводим минимальное количество монет
print(f"{coin_count}")
