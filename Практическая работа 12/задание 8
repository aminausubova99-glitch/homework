numbers = [25, 12, 40, 7, 18] #список из пяти чисел

min_value = min(numbers) #ищем минимальный элемент

min_index = 0 #находим индекс минимальный

for i in range(len(numbers)):
    if numbers[i] == min_value:
        min_index = i
        break

#теперь меняем местами первый элемент и минимальный
numbers[0], numbers[min_index] = numbers[min_index], numbers[0]

print("Список после обмена:", numbers) #выводим
