marks = [5, 4, 3, 5, 2, 5, 4, 3, 5, 5] #список оценок

five = 0
two = 0

#перебираем оценки в списке
for mark in marks:
    #крч, если оценка равна 5, увеличиваеться счётчик пятёрок
    if mark == 5:
        five += 1
    #а если оценка равна 2, увеличиваеться счётчик двоек
    elif mark == 2:
        two += 1

print(f"Количество пятёрок: {five}")
print(f"Количество двоек: {two}")
