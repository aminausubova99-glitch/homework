prices = [1500, 500, 2000, 3500, 1000, 4500] #список цен товаров 

max_price = max(prices)
min_price = min(prices)

total_price = sum(prices) #насчитываем общую стоимость товаров

average_price = total_price / len(prices) #средняя цена товара

print(f"Самый дорогой товар: {max_price}")
print(f"Самый дешёвый товар: {min_price}")
print(f"Общая стоимость товаров: {total_price}")
print(f"Средняя цена товара: {average_price:.2f}")
