gruppa_1 = {'Иван', 'Мария', 'Петр', 'Сергей', 'Анна'}
gruppa_2 = {'Мария', 'Анна', 'Дмитрий', 'Елена', 'Сергей'}

print("В обеих группах:", gruppa_1.intersection(gruppa_2)) #ищем студентов в 2 группах

print("Только в первой:", gruppa_1.difference(gruppa_2)) #ищем студентов только в 1 группе

print("Только во второй:", gruppa_2.difference(gruppa_1)) #ищем студентов только во 2 группе

print("Все студенты:", gruppa_1.union(gruppa_2)) #ищем всех студентов

print("Только в одной группе:", gruppa_1.symmetric_difference(gruppa_2)) #ищем студентов только в одной группе
